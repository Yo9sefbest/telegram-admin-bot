# Get a token from @BotFather on Telegram
BOT_TOKEN=123456:replace-me

# Comma-separated Telegram user IDs allowed to use admin tools (get yours from @userinfobot)
ADMIN_IDS=111111111

# Web dashboard login (use a strong password, at least 8 characters)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Dashboard address. Keep 127.0.0.1 unless you put it behind HTTPS (nginx/Caddy)
HOST=127.0.0.1
PORT=3000

DB_PATH=./data/bot.db
